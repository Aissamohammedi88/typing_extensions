# ═══════════════════════════════════════════════════════════════════════════
# COULEURS ANSI
# ═══════════════════════════════════════════════════════════════════════════
class C:
R = '\033[0;31m'
G = '\033[0;32m'
Y = '\033[1;33m'
B = '\033[0;36m'
M = '\033[0;35m'
N = '\033[0m'
BOLD = '\033[1m'
DIM = '\033[2m'

def info(msg): print(f"{C.B}[INFO]{C.N} {msg}")
def ok(msg): print(f"{C.G}[ OK ]{C.N} {msg}")
def warn(msg): print(f"{C.Y}[WARN]{C.N} {msg}")
def err(msg): print(f"{C.R}[FAIL]{C.N} {msg}")
def hr(): print(f"{C.B}{'─' * 70}{C.N}")


# ═══════════════════════════════════════════════════════════════════════════
# MÉTRIQUES MÉMOIRE
# ═══════════════════════════════════════════════════════════════════════════
@dataclass
class MemoryStats:
rss_kb: int = 0
vms_kb: int = 0
peak_kb: int = 0
python_objects: int = 0
gc_gen0: int = 0
gc_gen1: int = 0
gc_gen2: int = 0
tracemalloc_current: int = 0
tracemalloc_peak: int = 0
timestamp: str = ""

def to_dict(self) -> Dict[str, Any]:
return asdict(self)


def get_memory_stats() -> MemoryStats:
"""Récupère les stats mémoire actuelles."""
stats = MemoryStats(timestamp=datetime.now().isoformat())

# RSS / VMS via resource
try:
usage = resource.getrusage(resource.RUSAGE_SELF)
stats.rss_kb = usage.ru_maxrss # Peak RSS en KB sur Linux
except Exception:
pass

# /proc/self/status pour précision
try:
with open("/proc/self/status") as f:
for line in f:
if line.startswith("VmRSS:"):
stats.rss_kb = int(line.split()[1])
elif line.startswith("VmSize:"):
stats.vms_kb = int(line.split()[1])
elif line.startswith("VmPeak:"):
stats.peak_kb = int(line.split()[1])
except Exception:
pass

# Objets Python
stats.python_objects = len(gc.get_objects())
stats.gc_gen0, stats.gc_gen1, stats.gc_gen2 = gc.get_count()

# Tracemalloc
if tracemalloc.is_tracing():
current, peak = tracemalloc.get_traced_memory()
stats.tracemalloc_current = current
stats.tracemalloc_peak = peak

return stats


@contextmanager
def memory_tracker(label: str = "block"):
"""Context manager qui mesure la mémoire d'un bloc."""
gc.collect()
before = get_memory_stats()
tracemalloc.start()
t0 = time.time()
try:
yield
finally:
elapsed = time.time() - t0
after = get_memory_stats()
current, peak = tracemalloc.get_traced_memory()
tracemalloc.stop()

delta_rss = after.rss_kb - before.rss_kb
delta_objects = after.python_objects - before.python_objects══

status = C.G if delta_rss < 1000 else C.Y if delta_rss < 10000 else C.R
print(f"\n{status}📊 [{label}]{C.N}")
print(f" ⏱️ Temps : {elapsed*1000:.2f} ms")
print(f" 📈 RSS delta : {delta_rss:+} KB")
print(f" 🔢 Objets delta : {delta_objects:+}")
print(f" 📊 Peak tracemalloc: {peak / 1024:.1f} KB")
print(f" 💾 RSS actuel : {after.rss_kb / 1024:.1f} MB")


