def cmd_029_rot_n():
"""29. ROT-N cipher"""
text = input(f"{C.YELLOW}Texte : {C.RESET}")
try:
n = int(input(f"{C.YELLOW}Rotation N : {C.RESET}"))
except ValueError:
n = 13
def rot(s, n):
result = ""
for c in s:
if c.isalpha():
base = ord('A') if c.isupper() else ord('a')
result += chr((ord(c) - base + n) % 26 + base)
else:
result += c
return result
print(f"\n{C.GREEN}{rot(text, n)}{C.RESET}")


def cmd_030_vigenere():
