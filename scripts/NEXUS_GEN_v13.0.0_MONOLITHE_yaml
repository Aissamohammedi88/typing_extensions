<script>
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function post(url, data){return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(r=>r.json());}
function updateSlider(){document.getElementById('mass-lignes-val').textContent=parseInt(document.getElementById('mass-lignes').value).toLocaleString();}

async function genererMassif(){
var prompt = document.getElementById('mass-prompt').value.trim();
var lang = document.getElementById('mass-lang').value;
var port = parseInt(document.getElementById('mass-port').value) || 3001;
var lignes = parseInt(document.getElementById('mass-lignes').value) || 10000;
if(!prompt){ alert('Prompt requis'); return; }
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Génération + scan + scoring...</div></div>';
try {
var d = await post('/api/generate-massif', {prompt: prompt, langage: lang, port: port, lignes: lignes});
if(!d.ok){ document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(d.error) + '</div>'; return; }
var s = d.score || {};
var h = '<div class="stat"><div class="stat-lbl">Lignes</div><div class="stat-val ok">' + (d.lignes||0).toLocaleString() + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Score</div><div class="stat-val ' + (s.score >= 80 ? 'ok' : s.score >= 50 ? 'warn' : 'critical') + '">' + (s.score||0) + '/100</div></div>';
h += '<div class="stat"><div class="stat-lbl">Findings</div><div class="stat-val">' + (s.findings_count||0) + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Clean</div><div class="stat-val">' + ((s.proba_clean||0)*100).toFixed(1) + '%</div></div>';
h += '<div class="stat"><div class="stat-lbl">Critical</div><div class="stat-val critical">' + ((s.severity_counts?.critical)||0) + '</div></div>';
document.getElementById('stats').innerHTML = h;
var sd = '<div class="panel" style="margin:12px 0"><h2>Confiance bayésienne du code</h2><div>Proba clean: ' + ((s.proba_clean||0)*100).toFixed(1) + '%</div><div class="bayes-bar"><div class="bayes-fill" style="width:' + ((s.proba_clean||0)*100) + '%"></div></div></div>';
document.getElementById('score-display').innerHTML = sd;
var fh = '<h3 style="color:#00d4ff;font-size:11px;margin:12px 0 8px">🔬 Findings (' + (d.findings||[]).length + ')</h3>';
(d.findings||[]).slice(0,50).forEach(f => {
fh += '<div class="finding finding-' + esc(f.severity) + '"><b>[' + esc(f.rule_id) + '] ' + esc(f.name) + '</b><br>Ligne ' + f.line + ' · ' + esc(f.cwe||'') + ' · conf: ' + esc(f.confidence) + '<br><code style="color:#a0b8d0">' + esc(f.snippet||'') + '</code></div>';
});
document.getElementById('findings').innerHTML = fh;
var a = d.autofix || {};
if(a.fixes_count > 0){
var ah = '<h3 style="color:#00ff88;font-size:11px;margin:12px 0 8px">🔧 Autofix (' + a.fixes_count + ' corrections proposées · ' + (a.estimated_fix_effort_min||0) + ' min)</h3>';
(a.fixes||[]).slice(0,20).forEach(fx => {
ah += '<div class="finding finding-low"><b>' + esc(fx.rule_id) + '</b> Ligne ' + fx.line + '<br><span style="color:#ff8888">❌ ' + esc(fx.current) + '</span><br><span style="color:#00ff88">✅ ' + esc(fx.fix) + '</span></div>';
});
document.getElementById('autofix').innerHTML = ah;
}
document.getElementById('code-output').textContent = (d.code || '').substring(0, 3000) + '\n\n... (tronqué)';
window.__code = d.code || '';
} catch(e) { document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(e.message) + '</div>'; }
}

async function scannerCode(){
var code = document.getElementById('scan-code').value.trim();
var lang = document.getElementById('scan-lang').value;
if(!code){ alert('Code requis'); return; }
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Scan...</div></div>';
try {
var d = await post('/api/scan', {code: code, langage: lang});
var s = d.score || {};
var h = '<div class="stat"><div class="stat-lbl">Score</div><div class="stat-val ' + (s.score >= 80 ? 'ok' : 'warn') + '">' + (s.score||0) + '/100</div></div>';
h += '<div class="stat"><div class="stat-lbl">Findings</div><div class="stat-val">' + (d.findings?.length||0) + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Clean</div><div class="stat-val">' + ((s.proba_clean||0)*100).toFixed(1) + '%</div></div>';
document.getElementById('stats').innerHTML = h;
var fh = '<h3 style="color:#00d4ff;font-size:11px;margin:12px 0 8px">🔬 Findings</h3>';
(d.findings||[]).forEach(f => {
fh += '<div class="finding finding-' + esc(f.severity) + '"><b>[' + esc(f.rule_id) + '] ' + esc(f.name) + '</b> Ligne ' + f.line + '<br><code>' + esc(f.snippet||'') + '</code></div>';
});
document.getElementById('findings').innerHTML = fh || '<div class="finding finding-low">Aucun finding</div>';
document.getElementById('autofix').innerHTML = '';
document.getElementById('code-output').textContent = '';
} catch(e){ document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(e.message) + '</div>'; }
}

async function genererYaml(){
var prompt = document.getElementById('yaml-prompt').value.trim();
var lignes = parseInt(document.getElementById('yaml-lignes').value) || 1000;
if(!prompt){ alert('Prompt requis'); return; }
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Génération YAML...</div></div>';
try {
var d = await post('/api/yaml/generate', {prompt: prompt, lignes: lignes});
document.getElementById('stats').innerHTML = '<div class="stat"><div class="stat-lbl">Lignes</div><div class="stat-val ok">' + d.lignes + '</div></div>';
document.getElementById('code-output').textContent = d.code || '';
} catch(e){ document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(e.message) + '</div>'; }
}

async function validerYaml(){
var yaml = document.getElementById('scan-code').value.trim();
if(!yaml){ alert('YAML requis'); return; }
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Validation...</div></div>';
try {
var d = await post('/api/yaml/validate', {yaml: yaml});
var h = '<div class="stat"><div class="stat-lbl">Verdict</div><div class="stat-val ' + (d.ok?'ok':'critical') + '">' + esc(d.verdict||'?') + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Score</div><div class="stat-val">' + (d.score||0) + '/100</div></div>';
h += '<div class="stat"><div class="stat-lbl">Erreurs</div><div class="stat-val">' + (d.errors?.length||0) + '</div></div>';
document.getElementById('stats').innerHTML = h;
} catch(e){ document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(e.message) + '</div>'; }
}

async function optimiserYaml(){
var yaml = document.getElementById('scan-code').value.trim();
if(!yaml){ alert('YAML requis'); return; }
document.getElementById('result-panel').style.display = 'block';
document.getElementById('stats').innerHTML = '<div class="loader"><div class="spinner"></div><div>Optimisation...</div></div>';
try {
var d = await post('/api/yaml/optimize', {yaml: yaml});
var h = '<div class="stat"><div class="stat-lbl">Avant</div><div class="stat-val">' + (d.score_before||0) + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Après</div><div class="stat-val ok">' + (d.score_after||0) + '</div></div>';
h += '<div class="stat"><div class="stat-lbl">Optimisations</div><div class="stat-val ok">' + (d.optimizations?.length||0) + '</div></div>';
document.getElementById('stats').innerHTML = h;
} catch(e){ document.getElementById('stats').innerHTML = '<div class="result">Erreur: ' + esc(e.message) + '</div>'; }
}
</script></body></html>
"""

# ═══════════════════════════════════════════════════════════════
# HANDLER HTTP
# ═══════════════════════════════════════════════════════════════
class Handler(BaseHTTPRequestHandler):
rbufsize = BUFFER_SIZE
wbufsize = BUFFER_SIZE

def log_message(self, *a): pass

def _send(self, code, body, ctype="application/json"):
try:
if isinstance(body, str): body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
for i in range(0, len(body), BUFFER_SIZE):
self.wfile.write(body[i:i+BUFFER_SIZE])
self.wfile.flush()
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", "0"))
raw = self.rfile.read(n) if n <= BUFFER_SIZE * 2 else b""
return json.loads(raw.decode("utf-8"))
except: return {}

def do_GET(self):
p = self.path.split("?")[0]
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
if p in ("/", "/index.html"):
html = (HTML_UI.replace("__V__", VERSION)
.replace("__AUTEUR__", AUTEUR)
.replace("__PORT__", str(PORT))
.replace("__LANG__", str(len(LANGAGES_SUPPORTES)))
.replace("__API__", str(len(APIS)))
.replace("__RULES__", str(len(RULES)))
.replace("__ENGINES__", str(20)))
return self._send(200, html, "text/html")
if p == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "port": PORT,
"min_lignes": MIN_LIGNES, "max_lignes": MAX_LIGNES,
"langs": len(LANGAGES_SUPPORTES), "apis": len(APIS),
"rules": len(RULES), "kb_size": KB.size(),
}))
if p == "/api/rules":
rules_list = [{"id": r.id, "name": r.name, "severity": r.severity,
"category": r.category, "cwe": r.cwe, "languages": r.languages}
for r in RULES.values()]
return self._send(200, json.dumps({"rules": rules_list, "total": len(rules_list)}))
if p == "/api/search":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
return self._send(200, json.dumps({"query": q, "results": search_all_apis(q)}, ensure_ascii=False, default=str))
return self._send(404, json.dumps({"error": "not found"}))

def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()

if p == "/api/generate-massif":
prompt = data.get("prompt", "").strip()
langage = data.get("langage", "python").lower()
port = int(data.get("port", 3001))
lignes = max(MIN_LIGNES, min(MAX_LIGNES, int(data.get("lignes", DEFAULT_LIGNES))))
if not prompt: return self._send(400, json.dumps({"error": "prompt manquant"}))
if langage not in BLOCS: return self._send(400, json.dumps({"error": f"langage non supporté: {langage}"}))
result = REASONING.full_reasoning(prompt, langage, lignes)
result["port"] = port
return self._send(200, json.dumps(result, ensure_ascii=False, default=str))

if p == "/api/scan":
code = data.get("code", "")
langage = data.get("langage", "python")
if not code: return self._send(400, json.dumps({"error": "code manquant"}))
findings = ENGINE.scan_code(code, langage)
findings = ENGINE.deduplicate_findings(findings)
score = ENGINE.score_code(findings)
autofix = ENGINE.autofix_generate(findings, code)
return self._send(200, json.dumps({
"ok": True, "findings": findings, "score": score, "autofix": autofix,
"total_rules_applied": len(RULES),
}, ensure_ascii=False, default=str))

if p == "/api/autofix":
code = data.get("code", "")
langage = data.get("langage", "python")
findings = ENGINE.scan_code(code, langage)
findings = ENGINE.deduplicate_findings(findings)
return self._send(200, json.dumps(ENGINE.autofix_generate(findings, code), ensure_ascii=False))

if p == "/api/yaml/generate":
prompt = data.get("prompt", "CI/CD Pipeline")[:200]
cible = max(100, min(5000, int(data.get("lignes", 1000))))
code = generer_yaml_github(prompt, cible)
return self._send(200, json.dumps({
"ok": True, "category": prompt, "cible": cible, "code": code,
"lignes": code.count("\n") + 1, "octets": len(code.encode()),
}, ensure_ascii=False))

if p == "/api/yaml/validate":
yaml_content = data.get("yaml", "")
if not yaml_content: return self._send(400, json.dumps({"error": "yaml manquant"}))
return self._send(200, json.dumps(validate_yaml_github(yaml_content), ensure_ascii=False))

if p == "/api/yaml/optimize":
yaml_content = data.get("yaml", "")
if not yaml_content: return self._send(400, json.dumps({"error": "yaml manquant"}))
return self._send(200, json.dumps(optimize_yaml_github(yaml_content), ensure_ascii=False))

return self._send(404, json.dumps({"error": "not found"}))


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True
request_queue_size = 1000


def ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]; s.close(); return ip
except: return "localhost"


def main():
print("=" * 72)
print(f" NEXUS GEN v{VERSION} — MONOLITHE SUPRÊME TOTAL+")
print(f" Port {PORT} · Buffer {BUFFER_SIZE} · Lignes {MIN_LIGNES:,}-{MAX_LIGNES:,}")
print(f" {len(LANGAGES_SUPPORTES)} langages · {len(APIS)} APIs · {len(RULES)} règles")
print(f" Moteurs : AST · Fingerprinting · Scoring bayésien · Autofix")
print("=" * 72)
print(f" Local : http://localhost:{PORT}/")
print(f" Réseau : http://{ip_locale()}:{PORT}/")
print(f" Endpoints :")
print(f" POST /api/generate-massif ← génération + scan + score + autofix")
print(f" POST /api/scan ← scan seul")
print(f" POST /api/autofix ← autofix seul")
print(f" POST /api/yaml/generate ← génération YAML")
print(f" POST /api/yaml/validate ← validation YAML")
print(f" POST /api/yaml/optimize ← optimisation YAML")
print(f" GET /api/rules ← liste des règles")
print(f" GET /api/health ← santé")
print("=" * 72)
print(" Ctrl+C pour arrêter")
try:
with Server(("0.0.0.0", PORT), Handler) as httpd:
httpd.serve_forever()
except KeyboardInterrupt:
print("\n Arrêté.")
except OSError as e:
print(f" Erreur port {PORT}: {e}")
sys.exit(1)


if __name__ == "__main__":
try: main()
except Exception as e:
