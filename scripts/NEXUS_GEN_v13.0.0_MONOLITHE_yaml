def detecter_langage(fichier):
if not fichier: return None
base = os.path.basename(fichier).lower()
specials = {"dockerfile":"dockerfile","makefile":"makefile","cmakelists.txt":"cmake"}
if base in specials: return specials[base]
for ext in sorted(EXT_TO_LANG.keys(), key=len, reverse=True):
if base.endswith(ext): return EXT_TO_LANG[ext]
return None

def detecter_niche(langage):
return [k for k, v in NICHES.items() if langage in v["langages"]]

# ═══════════════════════════════════════════════════════════════
# AST PARSERS (contrairement à v12 qui fait que du regex)
# ═══════════════════════════════════════════════════════════════
class ASTParsers:
"""Parseurs AST réels pour détecter des patterns profonds."""

@staticmethod
def parse_python(code: str) -> Optional[pyast.AST]:
try:
return pyast.parse(code)
except (SyntaxError, ValueError):
return None

@staticmethod
def extract_python_info(tree: pyast.AST) -> Dict[str, Any]:
"""Extrait imports, fonctions, classes, appels dangereux."""
info = {
"imports": [], "functions": [], "classes": [],
"dangerous_calls": [], "hardcoded_strings": [],
"try_blocks": 0, "bare_excepts": 0,
"functions_without_docstring": 0,
"long_functions": [],
"complexity_estimate": 0,
}
if tree is None:
return info
try:
for node in pyast.walk(tree):
if isinstance(node, pyast.Import):
for alias in node.names:
info["imports"].append(alias.name)
elif isinstance(node, pyast.ImportFrom):
info["imports"].append(f"{node.module}.{node.names[0].name}" if node.names else str(node.module))
elif isinstance(node, pyast.FunctionDef):
info["functions"].append(node.name)
lines = (node.end_lineno or node.lineno) - node.lineno
if lines > 50:
info["long_functions"].append({"name": node.name, "lines": lines})
if not pyast.get_docstring(node):
info["functions_without_docstring"] += 1
info["complexity_estimate"] += 1
elif isinstance(node, pyast.ClassDef):
info["classes"].append(node.name)
elif isinstance(node, pyast.Call):
fn_name = ""
if isinstance(node.func, pyast.Name):
fn_name = node.func.id
elif isinstance(node.func, pyast.Attribute):
fn_name = node.func.attr
if fn_name in ("eval", "exec", "compile", "__import__"):
info["dangerous_calls"].append({"fn": fn_name, "line": node.lineno})
elif isinstance(node, pyast.Constant):
if isinstance(node.value, str) and len(node.value) > 20:
if any(x in node.value.lower() for x in ["password", "secret", "token", "key="]):
info["hardcoded_strings"].append({"line": node.lineno, "preview": node.value[:40]})
elif isinstance(node, pyast.Try):
info["try_blocks"] += 1
for handler in node.handlers:
if handler.type is None:
info["bare_excepts"] += 1
except Exception:
pass
return info

@staticmethod
def parse_javascript(code: str) -> Dict[str, Any]:
"""Parse JS basique via regex structuré (pas d'AST natif)."""
info = {"functions": [], "classes": [], "dangerous_calls": [],
"eval_usage": [], "innerhtml_usage": []}
for m in re.finditer(r"(?:function|const|let|var)\s+(\w+)\s*(?:\(|=)", code):
info["functions"].append(m.group(1))
for m in re.finditer(r"class\s+(\w+)", code):
info["classes"].append(m.group(1))
for m in re.finditer(r"\beval\s*\(", code):
info["eval_usage"].append({"line": code[:m.start()].count("\n") + 1})
for m in re.finditer(r"\.innerHTML\s*=", code):
info["innerhtml_usage"].append({"line": code[:m.start()].count("\n") + 1})
return info

# ═══════════════════════════════════════════════════════════════
# FINGERPRINTING (comme Semgrep)
# ═══════════════════════════════════════════════════════════════
class Fingerprinter:
"""Génère une empreinte unique pour chaque finding (stable entre versions)."""

@staticmethod
def compute(rule_id: str, file: str, code_snippet: str) -> str:
"""Empreinte basée sur la règle + fichier + contenu normalisé."""
normalized = re.sub(r"\s+", " ", code_snippet.strip().lower())[:200]
payload = f"{rule_id}::{file}::{normalized}"
return hashlib.sha256(payload.encode()).hexdigest()[:16]

@staticmethod
def is_duplicate(fp: str, existing: Set[str]) -> bool:
return fp in existing

# ═══════════════════════════════════════════════════════════════
# SCORING BAYÉSIEN (au lieu de compter)
# ═══════════════════════════════════════════════════════════════
class BayesianScorer:
"""
Scoring probabiliste bayésien pour refléter la confiance réelle
d'un finding, pas juste un compte.
"""

# Priorités de base par sévérité
BASE_PRIORS = {
"critical": 0.95,
"high": 0.75,
"medium": 0.5,
"low": 0.25,
"info": 0.1,
}

# Ajustements par confiance (ratio faux positifs historique)
CONFIDENCE_ADJUST = {
"high": 1.0,
"medium": 0.85,
"low": 0.5,
}

def __init__(self):
self.weights = self._load_weights()

def _load_weights(self) -> Dict[str, float]:
wfile = BASE / "weights" / "scoring.json"
if wfile.exists():
try:
return json.loads(wfile.read_text())
except Exception:
pass
return {}

def save_weights(self):
wfile = BASE / "weights" / "scoring.json"
try:
wfile.write_text(json.dumps(self.weights, indent=2))
except Exception:
pass

def score_finding(self, severity: str, confidence: str = "high",
rule_weight: float = 1.0) -> float:
"""Retourne proba [0-1] que le finding soit un vrai positif."""
prior = self.BASE_PRIORS.get(severity, 0.5)
adj = self.CONFIDENCE_ADJUST.get(confidence, 1.0)
custom = self.weights.get(f"{severity}:{confidence}", 1.0)
proba = prior * adj * custom * rule_weight
return min(1.0, max(0.0, proba))

def score_code(self, findings: List[Dict]) -> Dict[str, Any]:
"""Score global pondéré du code."""
if not findings:
return {
"score": 100, "proba_clean": 1.0, "severity_counts": {},
"weighted_score": 100, "critical_mass": 0.0,
}

probas = []
severity_counts = Counter()
for f in findings:
p = self.score_finding(
f.get("severity", "medium"),
f.get("confidence", "high"),
f.get("rule_weight", 1.0),
)
probas.append(p)
severity_counts[f.get("severity", "medium")] += 1

# Proba que le code soit "sale" (fusion bayésienne)
proba_dirty = 1 - math.prod(1 - p for p in probas)
proba_clean = 1 - proba_dirty

# Score pondéré (critical pèse plus)
weighted_penalty = sum(
probas[i] * {"critical": 20, "high": 10, "medium": 4, "low": 1, "info": 0.2}.get(
findings[i].get("severity", "medium"), 4
)
for i in range(len(probas))
)
weighted_score = max(0, 100 - weighted_penalty)

return {
"score": round(weighted_score, 1),
"proba_clean": round(proba_clean, 3),
"proba_dirty": round(proba_dirty, 3),
"severity_counts": dict(severity_counts),
"weighted_score": round(weighted_score, 1),
"critical_mass": round(sum(1 for f in findings if f.get("severity") == "critical") / len(findings), 3) if findings else 0.0,
"findings_count": len(findings),
"high_confidence_findings": sum(1 for f in findings if f.get("confidence") == "high"),
}

# ═══════════════════════════════════════════════════════════════
# MOTEUR DE RÈGLES (comme SonarQube + Semgrep fusionnés)
# ═══════════════════════════════════════════════════════════════
@dataclass
class Rule:
id: str
name: str
severity: str
category: str
description: str
patterns: List[str] = field(default_factory=list)
languages: List[str] = field(default_factory=list)
cwe: str = ""
owasp: str = ""
confidence: str = "high"
rule_weight: float = 1.0
autofix: Optional[str] = None

RULES: Dict[str, Rule] = {}

def register_rule(rule: Rule):
RULES[rule.id] = rule

# Règles Python
register_rule(Rule("PY001", "eval() usage", "critical", "injection",
"eval() permet l'exécution arbitraire de code", ["\\beval\\s*\\("],
["python"], "CWE-95", "A03:2021", "high", 1.0,
"Remplacer eval() par ast.literal_eval() ou json.loads()"))

register_rule(Rule("PY002", "exec() usage", "critical", "injection",
"exec() permet l'exécution arbitraire", ["\\bexec\\s*\\("],
["python"], "CWE-95", "A03:2021", "high", 1.0,
"Éviter exec(), utiliser des mécanismes sécurisés"))

