class C:
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
WHITE = "\033[37m"
BG_RED = "\033[41m"
BG_GREEN = "\033[42m"
BG_YELLOW = "\033[43m"
BG_BLUE = "\033[44m"

@staticmethod
def disable():
for attr in dir(C):
if attr.isupper() and not attr.startswith("_"):
setattr(C, attr, "")

# ═══════════════════════════════════════════════════════════════════════════
# UTILITAIRES
# ═══════════════════════════════════════════════════════════════════════════

def human_bytes(n: int) -> str:
for unit in ["B", "KB", "MB", "GB", "TB"]:
if n < 1024:
return f"{n:.2f} {unit}"
n /= 1024
return f"{n:.2f} PB"

def human_time(sec: float) -> str:
if sec < 1:
return f"{sec * 1000:.1f} ms"
if sec < 60:
return f"{sec:.2f} s"
m, s = divmod(int(sec), 60)
if m < 60:
return f"{m} min {s} s"
h, m = divmod(m, 60)
return f"{h} h {m} min"

def now_iso() -> str:
return datetime.now().isoformat()

def colorize(text: str, color: str) -> str:
return f"{color}{text}{C.RESET}"

