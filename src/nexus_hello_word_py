def interactive_mode():
while True:
show_menu()
try:
choice = input(f"{C.YELLOW}➜ {C.RESET}").strip().upper()

if not choice:
continue
if choice in ("Q", "QUIT", "EXIT"):
print(f"\n{C.MAGENTA}👋 À bientôt !{C.RESET}\n")
break
if choice == "H":
show_help()
continue
if choice == "L":
list_commands()
continue

# Numéro de catégorie
if choice.isdigit():
n = int(choice)
# Catégorie
if 1 <= n <= len(CATEGORIES):
cat_name = list(CATEGORIES.keys())[n - 1]
cmds = CATEGORIES[cat_name]
print(f"\n{C.CYAN}Catégorie : {cat_name}{C.RESET}\n")
for c in cmds:
print(f" {C.GREEN}[{c:03d}]{C.RESET} {COMMANDS[c][0]}")
print()
sub = input(f"{C.YELLOW}Numéro de commande (ou Entrée pour retour) : {C.RESET}").strip()
if sub.isdigit():
run_command(int(sub))
continue

# Commande directe
if n in COMMANDS:
run_command(n)
continue

# Numéro de commande
if choice.startswith("#") and choice[1:].isdigit():
run_command(int(choice[1:]))
continue

print(f"{C.RED}Choix invalide : {choice}{C.RESET}")
time.sleep(1)

except KeyboardInterrupt:
print(f"\n\n{C.MAGENTA}👋 À bientôt !{C.RESET}\n")
break
except EOFError:
print(f"\n{C.MAGENTA}👋 À bientôt !{C.RESET}\n")
break
except Exception as e:
print(f"{C.RED}Erreur : {e}{C.RESET}")
time.sleep(2)


# ══════════════════════════════════════════════════════════════════════════════
# CLI MODE
# ══════════════════════════════════════════════════════════════════════════════

def cli_mode(args):
if not args:
interactive_mode()
return

if args[0] in ("-h", "--help"):
show_help()
return

if args[0] in ("-l", "--list"):
list_commands()
return

if args[0] in ("-v", "--version"):
print(f"NEXUS HELLO UNIVERSE v{VERSION}")
print(f"Auteur : {AUTHOR}")
return

if args[0] == "--cat" and len(args) > 1:
try:
n = int(args[1])
cat_name = list(CATEGORIES.keys())[n - 1]
for c in CATEGORIES[cat_name]:
print(f"\n{C.CYAN}{C.BOLD}[#{c:03d}] {COMMANDS[c][0]}{C.RESET}\n")
try:
COMMANDS[c][1]()
except KeyboardInterrupt:
break
except Exception as e:
print(f"{C.RED}Erreur : {e}{C.RESET}")
except (ValueError, IndexError):
print(f"{C.RED}Catégorie invalide{C.RESET}")
return

# Numéro de commande
if args[0].isdigit():
n = int(args[0])
if n in COMMANDS:
clear_screen()
print(f"{C.CYAN}{C.BOLD}[#{n:03d}] {COMMANDS[n][0]}{C.RESET}\n")
print(f"{C.DIM}{hr('─', 78)}{C.RESET}\n")
try:
COMMANDS[n][1]()
except Exception as e:
print(f"{C.RED}Erreur : {e}{C.RESET}")
else:
print(f"{C.RED}Commande {n} introuvable (1-88){C.RESET}")
return

print(f"{C.RED}Argument inconnu : {args[0]}{C.RESET}")
print(f"Utilise --help pour l'aide")


# ══════════════════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════════════════

def main():
args = sys.argv[1:]
cli_mode(args)


if __name__ == "__main__":
main()
