def run_command(num):
if num not in COMMANDS:
print(f"{C.RED}Commande {num} introuvable{C.RESET}")
return
name, fn = COMMANDS[num]
clear_screen()
print(f"{C.CYAN}{C.BOLD}[#{num:03d}] {name}{C.RESET}\n")
print(f"{C.DIM}{hr('─', 78)}{C.RESET}\n")
try:
fn()
except KeyboardInterrupt:
print(f"\n{C.YELLOW}Interrompu{C.RESET}")
except Exception as e:
print(f"\n{C.RED}Erreur : {e}{C.RESET}")
print()
input(f"{C.DIM}[Entrée pour continuer]{C.RESET}")


def list_commands():
clear_screen()
print(f"{C.CYAN}{C.BOLD}═══ TOUTES LES COMMANDES ({len(COMMANDS)}) ═══{C.RESET}\n")
for i, (num, (name, _)) in enumerate(COMMANDS.items(), 1):
