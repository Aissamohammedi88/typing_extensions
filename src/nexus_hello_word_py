text = input(f"{C.YELLOW}Texte : {C.RESET}").upper()
key = input(f"{C.YELLOW}Clé : {C.RESET}").upper()
if not key:
key = "KEY"
result = ""
ki = 0
for c in text:
if c.isalpha():
shift = ord(key[ki % len(key)]) - ord('A')
result += chr((ord(c) - ord('A') + shift) % 26 + ord('A'))
ki += 1
else:
result += c
print(f"\n{C.GREEN}{result}{C.RESET}")


