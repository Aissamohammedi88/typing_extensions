# ═══════════════════════════════════════════════════════════════
# MOTEUR DE RÈGLES (moteur de scan principal)
# ═══════════════════════════════════════════════════════════════
class RuleEngine:
"""Moteur qui applique les règles avec fingerprinting + scoring."""

def __init__(self):
self.fingerprinter = Fingerprinter()
self.scorer = BayesianScorer()
self.seen_fingerprints: Set[str] = set()

def scan_code(self, code: str, langage: str) -> List[Dict]:
"""Applique toutes les règles compatibles avec le langage."""
findings = []
lines = code.split("\n")

for rule_id, rule in RULES.items():
if rule.languages and langage not in rule.languages:
continue
for pattern in rule.patterns:
try:
regex = re.compile(pattern, re.MULTILINE)
for m in regex.finditer(code):
line_num = code[:m.start()].count("\n") + 1
matched_text = m.group(0)[:200]
snippet = lines[line_num - 1].strip() if line_num <= len(lines) else ""
if snippet.startswith(("#", "//", "/*", "*", "--")):
continue
if any(x in snippet.lower() for x in ["example", "placeholder", "xxx"]):
continue

fp = self.fingerprinter.compute(rule_id, f"<{langage}>", snippet)
if fp in self.seen_fingerprints:
continue
self.seen_fingerprints.add(fp)

finding = {
"rule_id": rule_id,
"name": rule.name,
"severity": rule.severity,
"category": rule.category,
"confidence": rule.confidence,
"rule_weight": rule.rule_weight,
"line": line_num,
"snippet": snippet[:200],
"matched": matched_text,
"cwe": rule.cwe,
"owasp": rule.owasp,
"fingerprint": fp,
"autofix": rule.autofix,
"description": rule.description,
}
findings.append(finding)
except re.error:
continue

# Enrichissement AST
if langage == "python":
tree = ASTParsers.parse_python(code)
ast_info = ASTParsers.extract_python_info(tree)
for call in ast_info.get("dangerous_calls", []):
fp = self.fingerprinter.compute("AST_CALL_" + call["fn"], "python", str(call["line"]))
if fp not in self.seen_fingerprints:
self.seen_fingerprints.add(fp)
findings.append({
"rule_id": f"AST_{call['fn'].upper()}",
"name": f"AST: {call['fn']}() appelé",
"severity": "critical",
"category": "injection",
"confidence": "high",
"rule_weight": 1.0,
"line": call["line"],
"snippet": "",
"matched": call["fn"],
"cwe": "CWE-95",
"owasp": "A03:2021",
"fingerprint": fp,
"autofix": f"Éviter {call['fn']}()",
"description": f"Appel {call['fn']}() détecté via AST",
})

return findings

def deduplicate_findings(self, findings: List[Dict]) -> List[Dict]:
"""Déduplique en gardant la plus haute sévérité."""
by_fp = {}
for f in findings:
fp = f["fingerprint"]
if fp not in by_fp:
by_fp[fp] = f
else:
current = by_fp[fp]
priority = {"critical": 4, "high": 3, "medium": 2, "low": 1, "info": 0}
if priority.get(f["severity"], 0) > priority.get(current["severity"], 0):
by_fp[fp] = f
return list(by_fp.values())

def score_code(self, findings: List[Dict]) -> Dict[str, Any]:
"""Score global via BayesianScorer."""
return self.scorer.score_code(findings)

def autofix_generate(self, findings: List[Dict], code: str) -> Dict[str, Any]:
"""Génère un rapport d'autofix."""
fixes = []
for f in findings:
if f.get("autofix"):
fixes.append({
"rule_id": f["rule_id"],
"line": f["line"],
"current": f.get("snippet", "")[:100],
"fix": f["autofix"],
"severity": f["severity"],
"fingerprint": f["fingerprint"],
})
return {
"fixes_count": len(fixes),
"fixes": fixes,
"fixable_ratio": len(fixes) / len(findings) if findings else 0.0,
"estimated_fix_effort_min": len(fixes) * 2,
}

ENGINE = RuleEngine()

# ═══════════════════════════════════════════════════════════════
# APIs EXTERNES (11)
# ═══════════════════════════════════════════════════════════════
HTTP_CACHE = {}
HTTP_LOCK = threading.Lock()

def http_get_json(url, headers=None, timeout=10, use_cache=True):
if use_cache:
with HTTP_LOCK:
e = HTTP_CACHE.get(url)
if e and time.time() - e["ts"] < 300:
return e["data"]
h = {"User-Agent": f"NexusGen/{VERSION}", "Accept": "*/*"}
if headers: h.update(headers)
try:
req = urllib.request.Request(url, headers=h)
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
data = json.loads(r.read().decode("utf-8", "ignore"))
if use_cache:
with HTTP_LOCK: HTTP_CACHE[url] = {"data": data, "ts": time.time()}
return data
except Exception as e:
return {"error": str(e)[:200]}

APIS = {}
def register_api(name):
def deco(fn): APIS[name] = fn; return fn
return deco

@register_api("pypi")
def _pypi(q, limit=5):
d = http_get_json(f"https://pypi.org/pypi/{urllib.parse.quote(q)}/json")
if "info" in d:
i = d["info"]
return [{"name": i.get("name"), "version": i.get("version"),
"summary": (i.get("summary") or "")[:200], "url": i.get("package_url")}]
return []

@register_api("npm")
def _npm(q, limit=5):
d = http_get_json(f"https://registry.npmjs.org/-/v1/search?text={urllib.parse.quote(q)}&size={limit}")
if not d or "objects" not in d: return []
return [{"name": o["package"].get("name"), "version": o["package"].get("version"),
"description": (o["package"].get("description") or "")[:200]} for o in d["objects"][:limit]]

@register_api("github")
def _github(q, limit=5):
d = http_get_json(f"https://api.github.com/search/repositories?q={urllib.parse.quote(q)}&per_page={limit}&sort=stars")
if not d or "items" not in d: return []
return [{"name": i.get("full_name"), "description": (i.get("description") or "")[:200],
"url": i.get("html_url"), "stars": i.get("stargazers_count")} for i in d["items"][:limit]]

@register_api("stackoverflow")
def _so(q, limit=5):
url = f"https://api.stackexchange.com/2.3/search/advanced?order=desc&sort=relevance&q={urllib.parse.quote(q)}&site=stackoverflow&pagesize={limit}"
d = http_get_json(url)
if not d or "items" not in d: return []
return [{"title": i.get("title"), "url": i.get("link"), "score": i.get("score")} for i in d["items"][:limit]]

@register_api("wikipedia")
def _wiki(q, limit=3):
url = f"https://fr.wikipedia.org/w/api.php?action=query&list=search&srsearch={urllib.parse.quote(q)}&srlimit={limit}&format=json"
d = http_get_json(url)
if not d or "query" not in d: return []
return [{"title": i.get("title")} for i in d["query"].get("search", [])[:limit]]

@register_api("huggingface")
def _hf(q, limit=5):
d = http_get_json(f"https://huggingface.co/api/models?search={urllib.parse.quote(q)}&limit={limit}&sort=downloads")
if not isinstance(d, list): return []
return [{"id": m.get("id"), "downloads": m.get("downloads", 0)} for m in d[:limit]]

@register_api("crates")
def _crates(q, limit=5):
d = http_get_json(f"https://crates.io/api/v1/crates?q={urllib.parse.quote(q)}&per_page={limit}")
if not d or "crates" not in d: return []
return [{"name": c.get("name")} for c in d["crates"][:limit]]

@register_api("duckduckgo")
def _ddg(q, limit=5):
d = http_get_json(f"https://api.duckduckgo.com/?q={urllib.parse.quote(q)}&format=json&no_html=1")
if not d or "error" in d: return []
results = []
if d.get("AbstractText"):
results.append({"title": d.get("Heading", ""), "snippet": d.get("AbstractText", "")[:400]})
return results[:limit]

@register_api("vscode")
def _vscode(q, limit=10):
payload = {"filters": [{"criteria": [{"filterType": 10, "value": q}], "pageSize": limit, "pageNumber": 1, "sortBy": 4, "sortOrder": 0}], "assetTypes": [], "flags": 0x100}
try:
body = json.dumps(payload).encode()
req = urllib.request.Request("https://marketplace.visualstudio.com/_apis/public/gallery/extensionquery",
data=body, headers={"Content-Type": "application/json",
"Accept": "application/json;api-version=3.0-preview.1",
"User-Agent": f"NexusGen/{VERSION}"}, method="POST")
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=15, context=ctx) as r:
d = json.loads(r.read().decode("utf-8", "ignore"))
if "results" in d:
return [{"name": e.get("extensionName"), "publisher": e.get("publisher", {}).get("publisherName"),
"display_name": e.get("displayName"), "description": (e.get("shortDescription") or "")[:200]}
for e in d["results"][0].get("extensions", [])[:limit]]
except Exception:
pass
return []

@register_api("eclipse")
def _eclipse(q, limit=10):
try:
req = urllib.request.Request(f"https://marketplace.eclipse.org/api/p/search?q={urllib.parse.quote(q)}&mpc=true",
headers={"User-Agent": f"NexusGen/{VERSION}"})
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=15, context=ctx) as r:
d = json.loads(r.read().decode("utf-8", "ignore"))
nodes = d if isinstance(d, list) else d.get("nodes", [])
return [{"name": n.get("name", ""), "id": n.get("id", ""),
"description": (n.get("shortdescription") or "")[:200],
"installs": n.get("installstotal", 0)} for n in nodes[:limit]]
except Exception:
return []

@register_api("osv")
def _osv(q, limit=5):
"""OSV.dev — vulnérabilités open source."""
payload = {"package": {"name": q, "ecosystem": "PyPI"}}
try:
req = urllib.request.Request("https://api.osv.dev/v1/query",
data=json.dumps(payload).encode(),
headers={"Content-Type": "application/json"},
method="POST")
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
d = json.loads(r.read().decode("utf-8", "ignore"))
vulns = d.get("vulns", [])
return [{"id": v.get("id"), "summary": (v.get("summary") or "")[:200],
"severity": v.get("severity", [{}])[0].get("type", "")} for v in vulns[:limit]]
except Exception:
return []

def search_all_apis(query, max_workers=12):
results = {}
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = {ex.submit(fn, query, 3): name for name, fn in APIS.items()}
for fut in as_completed(futures):
name = futures[fut]
try: results[name] = fut.result(timeout=20)
except Exception as e: results[name] = {"error": str(e)[:120]}
return results

# ═══════════════════════════════════════════════════════════════
# KNOWLEDGE BASE
# ═══════════════════════════════════════════════════════════════
KB_FILE = BASE / "knowledge" / "kb.jsonl"

class KnowledgeBase:
def __init__(self):
self.items = []
if KB_FILE.exists():
try:
with open(KB_FILE, "r") as f:
for line in f:
try: self.items.append(json.loads(line))
except: continue
except: pass
def add(self, item):
self.items.append(item)
try:
with open(KB_FILE, "a") as f: f.write(json.dumps(item, ensure_ascii=False) + "\n")
except: pass
def size(self): return len(self.items)

KB = KnowledgeBase()

def enrichir_kb(query):
results = search_all_apis(query)
count = 0
for api_name, items in results.items():
if not isinstance(items, list): continue
for item in items:
if not isinstance(item, dict): continue
KB.add({"source": api_name, "query": query,
"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"data": item})
count += 1
return count

# ═══════════════════════════════════════════════════════════════
# GÉNÉRATION MASSIVE (blocs diversifiés)
# ═══════════════════════════════════════════════════════════════
def _bloc_python(mid, port):
t = mid % 8
blocks = {
0: f'class Handler{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.routes = {{}}\n def add_route(self, path, fn):\n self.routes[path] = fn\n def handle(self, req):\n return self.routes.get(req, lambda: "404")()',
1: f'class Service{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.data = []\n def process(self, item):\n self.data.append(item)\n return len(self.data)',
2: f'class Model{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.name = "model_{mid:04d}"',
3: f'class Validator{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.rules = {{}}\n def validate(self, data):\n return all(f in data for f in self.rules)',
4: f'class Repository{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.items = {{}}\n def save(self, k, v):\n self.items[k] = v',
5: f'class Logger{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.lines = []\n def log(self, msg):\n self.lines.append(str(msg))',
6: f'class Cache{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.store = {{}}\n def set(self, k, v):\n self.store[k] = v',
7: f'class Processor{mid:04d}:\n def __init__(self):\n self.id = {mid}\n self.buffer = []\n def push(self, item):\n self.buffer.append(item)',
}
return blocks[t] + "\n"

def _bloc_java(mid, port):
t = mid % 4
classes = ["Module", "Service", "Model", "Validator"]
return f' static class {classes[t]}{mid:04d} {{ private int id = {mid}; }}\n'

def _bloc_rust(mid, port):
return f'pub struct Module{mid:04d} {{ id: u32 }}\nimpl Module{mid:04d} {{ pub fn new() -> Self {{ Self {{ id: {mid} }} }} }}\n'

def _bloc_go(mid, port):
return f'type Module{mid:04d} struct {{ ID int }}\nfunc NewModule{mid:04d}() *Module{mid:04d} {{ return &Module{mid:04d}{{ID: {mid}}} }}\n'

def _bloc_c(mid, port):
return f'static int m_{mid:04d}(void) {{ return {mid}; }}\n'

def _bloc_cpp(mid, port):
return f'class Module{mid:04d} {{ public: int id = {mid}; }};\n'

def _bloc_csharp(mid, port):
return f' class Module{mid:04d} {{ public int Id = {mid}; }}\n'

def _bloc_ruby(mid, port):
return f'class Module{mid:04d}\n def initialize\n @id = {mid}\n end\nend\n'

def _bloc_php(mid, port):
return f'class Module{mid:04d} {{\n public $id = {mid};\n}}\n'

def _bloc_swift(mid, port):
return f'class Module{mid:04d} {{ let id: Int = {mid} }}\n'

def _bloc_kotlin(mid, port):
return f'class Module{mid:04d} {{ val id: Int = {mid} }}\n'

def _bloc_typescript(mid, port):
return f'class Module{mid:04d} {{ id: number = {mid}; }}\n'

BLOCS = {
"python": _bloc_python, "java": _bloc_java, "rust": _bloc_rust,
"go": _bloc_go, "c": _bloc_c, "cpp": _bloc_cpp, "csharp": _bloc_csharp,
"ruby": _bloc_ruby, "php": _bloc_php, "swift": _bloc_swift,
"kotlin": _bloc_kotlin, "typescript": _bloc_typescript,
}

def _header(langage, prompt, port, cible):
headers = {
"python": f'#!/usr/bin/env python3\n# NEXUS MASSIF | Port {port} | {cible} lignes | v{VERSION}\nimport json\nVERSION = "{VERSION}"\nPORT = {port}\n\n',
"java": f'// NEXUS MASSIF | Port {port} | v{VERSION}\npublic class Nexus {{\n public static final int PORT = {port};\n',
"rust": f'// NEXUS MASSIF | Port {port} | v{VERSION}\nconst PORT: u16 = {port};\n\n',
"go": f'// NEXUS MASSIF | Port {port} | v{VERSION}\npackage main\nimport "fmt"\nconst PORT = {port}\n\n',
"c": f'/* NEXUS MASSIF | Port {port} */\n#include <stdio.h>\n#define PORT {port}\n\n',
"cpp": f'// NEXUS MASSIF | Port {port}\n#include <iostream>\nconstexpr int PORT = {port};\n\n',
"csharp": f'// NEXUS MASSIF | Port {port}\nnamespace Nexus {{\n class Program {{\n public const int PORT = {port};\n',
"ruby": f'#!/usr/bin/env ruby\n# NEXUS MASSIF | Port {port}\nPORT = {port}\n\n',
"php": f'<?php\n// NEXUS MASSIF | Port {port}\ndefine("PORT", {port});\n\n',
"swift": f'// NEXUS MASSIF | Port {port}\nlet PORT: UInt16 = {port}\n\n',
"kotlin": f'// NEXUS MASSIF | Port {port}\nconst val PORT = {port}\n\n',
"typescript": f'// NEXUS MASSIF | Port {port}\nconst PORT = {port};\n\n',
}
return headers.get(langage, f"// NEXUS MASSIF — {langage}\n\n")

def _footer(langage, mid):
footers = {
"python": f'\nif __name__ == "__main__":\n print(f"NEXUS MASSIF v{VERSION} — {mid-1} modules — Port {{PORT}}")\n',
"java": f' public static void main(String[] a) {{ System.out.println("NEXUS MASSIF — {mid-1} modules"); }}\n }}\n}}\n',
"rust": f'\nfn main() {{ println!("NEXUS MASSIF — {mid-1} modules"); }}\n',
"go": f'\nfunc main() {{ fmt.Println("NEXUS MASSIF — {mid-1} modules") }}\n',
"c": f'\nint main(void) {{ printf("NEXUS MASSIF — {mid-1} modules\\n"); return 0; }}\n',
"cpp": f'\nint main() {{ std::cout << "NEXUS MASSIF — {mid-1} modules" << std::endl; return 0; }}\n',
"csharp": f' static void Main() {{ System.Console.WriteLine("NEXUS MASSIF — {mid-1} modules"); }}\n }}\n}}\n',
"ruby": f'\nputs "NEXUS MASSIF — {mid-1} modules"\n',
"php": f'\necho "NEXUS MASSIF — {mid-1} modules\\n";\n',
"swift": f'\nprint("NEXUS MASSIF — {mid-1} modules")\n',
"kotlin": f'\nfun main() {{ println("NEXUS MASSIF — {mid-1} modules") }}\n',
"typescript": f'\nconsole.log("NEXUS MASSIF — {mid-1} modules");\n',
}
return footers.get(langage, f"\n// FIN — {mid-1} modules\n")

def generer_massif(prompt, langage, port, cible=DEFAULT_LIGNES):
cible = max(MIN_LIGNES, min(MAX_LIGNES, cible))
bloc_fn = BLOCS.get(langage, BLOCS["python"])
header = _header(langage, prompt, port, cible)
corps = []
lignes = header.count("\n")
mid = 1
while lignes < cible and mid <= 3000:
bloc = bloc_fn(mid, port)
corps.append(bloc)
lignes += bloc.count("\n")
mid += 1
return header + "\n".join(corps) + _footer(langage, mid)

# ═══════════════════════════════════════════════════════════════
# YAML GITHUB ACTIONS
# ═══════════════════════════════════════════════════════════════
GITHUB_ACTIONS_CATEGORIES = {
"ci": ["build", "test", "lint", "typecheck", "coverage"],
"cd": ["deploy-staging", "deploy-prod", "rollback", "blue-green"],
"docker": ["build-image", "push-image", "multi-arch", "scan"],
"release": ["tag", "changelog", "publish-npm", "publish-pypi", "github-release"],
"security": ["codeql", "snyk", "trivy", "dependabot", "sbom"],
"tests": ["unit", "integration", "e2e", "load", "matrix-test"],
"docs": ["mkdocs", "docusaurus", "sphinx", "pages"],
"notify": ["slack", "discord", "email", "teams"],
"quality": ["sonarqube", "codecov", "prettier", "eslint"],
"infra": ["terraform", "ansible", "kubernetes", "aws", "gcp"],
"ml": ["train", "evaluate", "deploy-model", "notebook-test"],
"mobile": ["android", "ios", "flutter", "react-native"],
}

def generer_yaml_github(prompt, cible=1000):
header = f'''# ═══════════════════════════════════════════════════════════════
# NEXUS YAML — GitHub Actions · v{VERSION}
# {prompt[:60]}
# {cible} lignes · {datetime.datetime.now().isoformat()}
# ═══════════════════════════════════════════════════════════════
name: "{prompt[:50]}"
on:
push:
branches: [ main, master ]
pull_request:
branches: [ main ]
workflow_dispatch:
permissions:
contents: read
pull-requests: write
env:
NODE_VERSION: '20'
PYTHON_VERSION: '3.11'
jobs:
'''
jobs = []
lignes = header.count("\n")
mid = 1
cats = list(GITHUB_ACTIONS_CATEGORIES.keys())
while lignes < cible and mid <= 200:
cat = cats[mid % len(cats)]
variant = GITHUB_ACTIONS_CATEGORIES[cat][mid % len(GITHUB_ACTIONS_CATEGORIES[cat])]
job = f'''
{cat}-{variant}-{mid:04d}:
name: "{cat} {variant} #{mid}"
runs-on: ubuntu-latest
timeout-minutes: 30
steps:
- uses: actions/checkout@v4
- uses: actions/setup-node@v4
with:
node-version: ${{{{ env.NODE_VERSION }}}}
cache: npm
- name: Run
run: echo "Job {mid} — {cat}/{variant}"
'''
jobs.append(job)
lignes += job.count("\n")
mid += 1
return header + "\n".join(jobs) + f"\n# FIN — {mid-1} jobs · {lignes} lignes\n"

def validate_yaml_github(yaml_content):
result = {"ok": True, "errors": [], "warnings": [], "info": [], "score": 100, "yaml_valid": False}
if not yaml_content or not yaml_content.strip():
result["ok"] = False
result["errors"].append({"code": "EMPTY", "msg": "YAML vide", "line": 0})
return result
try:
import yaml
data = yaml.safe_load(yaml_content)
result["yaml_valid"] = True
result["info"].append({"code": "YAML_OK", "msg": "Syntaxe YAML valide"})
except ImportError:
result["warnings"].append({"code": "NO_PYYAML", "msg": "PyYAML non installé"})
data = None
except Exception as e:
result["ok"] = False
result["errors"].append({"code": "YAML_SYNTAX", "msg": f"Syntaxe invalide: {str(e)[:200]}", "line": 0})
return result
if data and isinstance(data, dict):
for field in ["on", "jobs"]:
if field not in data:
result["ok"] = False
result["errors"].append({"code": f"MISSING_{field.upper()}", "msg": f"Champ manquant: {field}", "line": 0})
for pattern, msg, sev in [
(r"pull_request_target", "pull_request_target = injection", "CRITICAL"),
(r"curl\s+[^|]*\|\s*(?:ba)?sh", "curl|sh = arbitraire", "CRITICAL"),
(r"echo\s+\$\{\{\s*secrets\.", "Secret en clair", "HIGH"),
]:
for m in re.finditer(pattern, yaml_content, re.IGNORECASE):
line_num = yaml_content[:m.start()].count("\n") + 1
result["errors"].append({"code": f"DANGER_{sev}", "msg": f"{msg} (L{line_num})", "line": line_num})
result["score"] = max(0, 100 - len(result["errors"]) * 10 - len(result["warnings"]) * 3)
result["ok"] = len(result["errors"]) == 0
result["verdict"] = "✅ VALIDE" if result["ok"] and not result["warnings"] else ("⚠️ AVERTISSEMENTS" if result["ok"] else "❌ INVALIDE")
return result

def optimize_yaml_github(yaml_content):
result = {"ok": True, "optimizations": [], "score_before": 0, "score_after": 0, "improvements": []}
validation = validate_yaml_github(yaml_content)
result["score_before"] = validation["score"]
if not yaml_content.strip(): return result
if "actions/setup-node" in yaml_content and "cache:" not in yaml_content:
result["optimizations"].append({"type": "cache", "priority": "HIGH", "msg": "Cache Node manquant", "gain": "~40% gain temps", "fix": "Ajouter 'cache: npm'"})
if "actions/setup-python" in yaml_content and "cache:" not in yaml_content:
result["optimizations"].append({"type": "cache", "priority": "HIGH", "msg": "Cache Python manquant", "gain": "~60% gain temps", "fix": "Ajouter 'cache: pip'"})
if "concurrency:" not in yaml_content:
result["optimizations"].append({"type": "concurrency", "priority": "HIGH", "msg": "Pas de concurrency", "gain": "Annule runs obsolètes", "fix": "Ajouter concurrency cancel-in-progress"})
old_actions = {
"actions/checkout@v1": "actions/checkout@v4",
"actions/checkout@v2": "actions/checkout@v4",
"actions/checkout@v3": "actions/checkout@v4",
"actions/setup-node@v1": "actions/setup-node@v4",
"actions/setup-node@v2": "actions/setup-node@v4",
"actions/setup-node@v3": "actions/setup-node@v4",
"actions/upload-artifact@v3": "actions/upload-artifact@v4",
}
for old, new in old_actions.items():
if old in yaml_content:
result["optimizations"].append({"type": "obsolete", "priority": "HIGH", "msg": f"Action obsolète: {old}", "gain": "Compatibilité", "fix": f"Remplacer par {new}"})
bonus = sum(5 if o["priority"] == "CRITICAL" else 3 if o["priority"] == "HIGH" else 1 for o in result["optimizations"])
result["score_after"] = min(100, validation["score"] + bonus)
result["improvements"] = [o["fix"] for o in result["optimizations"]]
return result

# ═══════════════════════════════════════════════════════════════
# MOTEUR DE RAISONNEMENT (full_reasoning)
# ═══════════════════════════════════════════════════════════════
class ReasoningEngine:
def __init__(self):
self.steps = []

def analyze(self, prompt, langage):
t0 = time.time()
prompt_lower = prompt.lower()
analysis = {
"prompt": prompt, "langage": langage,
"niches": detecter_niche(langage) if langage in LANGAGES_SUPPORTES else [],
"mots_cles": [kw for kw in ["api","rest","http","server","database","auth","cache","queue","parser","cli","web","game","ml","ai"] if kw in prompt_lower],
"intent": "fix" if any(w in prompt_lower for w in ["fix","debug","corrige"]) else "generate",
}
analysis["complexite"] = 1 + len(analysis["mots_cles"])
self.steps.append({"phase": "analyze", "duration_ms": round((time.time() - t0) * 1000, 2)})
return analysis

def full_reasoning(self, prompt, langage, cible):
t0 = time.time()
self.steps = []
analysis = self.analyze(prompt, langage)
gen_t0 = time.time()
code = generer_massif(prompt, langage, 3001, cible)
self.steps.append({"phase": "generate", "duration_ms": round((time.time() - gen_t0) * 1000, 2), "lignes": code.count("\n") + 1})
scan_t0 = time.time()
findings = ENGINE.scan_code(code, langage)
findings = ENGINE.deduplicate_findings(findings)
self.steps.append({"phase": "scan", "duration_ms": round((time.time() - scan_t0) * 1000, 2), "findings": len(findings)})
score_t0 = time.time()
score = ENGINE.score_code(findings)
self.steps.append({"phase": "score", "duration_ms": round((time.time() - score_t0) * 1000, 2), "score": score["score"]})
fix_t0 = time.time()
autofix = ENGINE.autofix_generate(findings, code)
self.steps.append({"phase": "autofix", "duration_ms": round((time.time() - fix_t0) * 1000, 2), "fixes": autofix["fixes_count"]})
return {
"ok": True, "code": code, "lignes": code.count("\n") + 1, "cible": cible,
"octets": len(code.encode()), "langage": langage,
"analysis": analysis, "findings": findings, "score": score,
"autofix": autofix, "steps": self.steps,
"duration_ms": round((time.time() - t0) * 1000, 2),
"engine_version": VERSION,
}

REASONING = ReasoningEngine()

# ═══════════════════════════════════════════════════════════════
# HTML UI (mise à jour v13)
