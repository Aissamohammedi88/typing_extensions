print(f" Plateforme : {sys.platform}")
print(f" RSS actuel : {get_memory_stats().rss_kb / 1024:.2f} MB")


# ═══════════════════════════════════════════════════════════════════════════
# DÉCORATEURS (importables)
# ═══════════════════════════════════════════════════════════════════════════

def memory_limit(max_mb: int):
"""Décorateur qui limite la mémoire pendant l'exécution."""
def decorator(fn: Callable):
@wraps(fn)
def wrapper(*args, **kwargs):
try:
resource.setrlimit(resource.RLIMIT_AS, (max_mb * 1024 * 1024, max_mb * 1024 * 1024))
except Exception:
pass
return fn(*args, **kwargs)
return wrapper
return decorator


def timeout(seconds: int):
"""Décorateur qui timeout l'exécution."""
def decorator(fn: Callable):
@wraps(fn)
def wrapper(*args, **kwargs):
def handler(signum, frame):
raise TimeoutError(f"Timeout après {seconds}s")
old = signal.signal(signal.SIGALRM, handler)
signal.alarm(seconds)
try:
return fn(*args, **kwargs)
finally:
signal.alarm(0)
signal.signal(signal.SIGALRM, old)
return wrapper
return decorator


def profile_memory(fn: Callable):
"""Décorateur qui profile la mémoire."""
@wraps(fn)
def wrapper(*args, **kwargs):
gc.collect()
before = get_memory_stats()
t0 = time.time()

result = fn(*args, **kwargs)

elapsed = time.time() - t0
after = get_memory_stats()

print(f"\n📊 [profile_memory: {fn.__name__}]")
print(f" Temps : {elapsed*1000:.2f} ms")
print(f" RSS Δ : {after.rss_kb - before.rss_kb:+} KB")
print(f" Objets Δ : {after.python_objects - before.python_objects:+}")
return result
return wrapper


def cache_memory(maxsize: int = 128):
"""Cache LRU avec métriques mémoire."""
def decorator(fn: Callable):
cached = lru_cache(maxsize=maxsize)(fn)
@wraps(fn)
def wrapper(*args, **kwargs):
return cached(*args, **kwargs)
wrapper.cache_info = cached.cache_info
wrapper.cache_clear = cached.cache_clear
return wrapper
return decorator


# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════

def build_parser():
parser = argparse.ArgumentParser(
prog="nexus-py",
description=f"🧬 NEXUS-PY v{VERSION} — Python plus précis en mémoire",
formatter_class=argparse.RawDescriptionHelpFormatter,
epilog=f"Auteur : {AUTEUR} · Licence : {LICENCE}"
)
parser.add_argument("--version", action="version", version=f"NEXUS-PY v{VERSION}")

sub = parser.add_subparsers(dest="cmd", help="Commandes")

# stats
sub.add_parser("stats", help="Stats mémoire actuelles").set_defaults(func=cmd_stats)

# profile
p = sub.add_parser("profile", help="Profile un script")
p.add_argument("script", help="Script Python à profiler")
p.add_argument("--output", "-o", help="Fichier de sortie")
p.set_defaults(func=cmd_profile)

# leaks
p = sub.add_parser("leaks", help="Détecte les fuites mémoire")
p.add_argument("script", help="Script Python")
p.add_argument("--output", "-o", help="Rapport JSON")
p.set_defaults(func=cmd_leaks)

# optimize
p = sub.add_parser("optimize", help="Suggère des optimisations")
p.add_argument("script", help="Script Python")
p.add_argument("--output", "-o", help="Rapport JSON")
_ex p.set_defaults(func=cmd_optimize)

# sandbox
p = sub.add_parser("sandbox", helpc="Exécute avec limite mémoire")
p.add_argument("script", help="Script Python")
p.add_argument("--()
max-memory", "-m", type=int, default=500, help="Limite MB")
p.add_argument("--timeout", "-t", type=int, default=60, help="Timeout secondes")
p.set_defaults(func=cmd_sandbox)

# compare
p = sub.add_parser("compare", help="Compare 2 versions")
p.add_argument("script1", help="Version 1")
p.add_argument("script2", help="Version 2")
p.set_defaults(func=cmd_compare)

# imports
p = sub.add_parser("imports", help="Analyse les imports")
p.add_argument("script", help="Script Python")
p.add_argument("--output", "-o", help="Rapport JSON")
p.set_defaults(func=cmd_imports)

# gc
sub.add_parser("gc", help="Force GC").set_defaults(func=cmd_gc)

# watch
p = sub.add_parser("watch", help="Surveille en temps réel")
p.add_argument("--interval", "-i", type=float, default=1.0, help="Intervalle secondes")
p.set_defaults(func=cmd_watch)

# decorate
sub.add_parser("decorate", help="Exemples de décorateurs").set_defaults(func=cmd_decorate)

# benchmark
p = sub.add_parser("benchmark", help="Benchmark")
p.add_argument("script", help="Script Python")
p.add_argument("--iterations", "-n", type=int, default=10, help="Nombre d'itérations")
p.set_defaults(func=cmd_benchmark)

# version
sub.add_parser("version", help="Affiche la version").set_defaults(func=cmd_version)

return parser


def main():
parser = build_parser()
args = parser.parse_args()

if not args.cmd:
parser.print_help()
sys.exit(0)

try:
args.func(args)
except KeyboardInterrupt:
print(f"\n{C.Y}👋 Interrompu.{C.N}")
except Exception as e:
err(f"Erreur : {e}")
import traceback
traceback.print sys.exit(1)


if __name__ == "__main__":
main()
